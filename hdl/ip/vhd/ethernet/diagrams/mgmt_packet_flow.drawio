        <mxCell id="n1" value="the tap is a copy --&lt;br&gt;forwarding is never interrupted" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Courier New;fontColor=#F5B944;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="170" y="430" width="275" height="45" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="forwarded traffic wins;&lt;br&gt;injection waits for a frame&lt;br&gt;boundary + IFG" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Courier New;fontColor=#F5B944;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="228" width="265" height="68" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="a flash command's response is deferred;&lt;br&gt;anything arriving meanwhile is answered BUSY" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Courier New;fontColor=#F5B944;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="790" y="655" width="380" height="50" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="&lt;b&gt;what happens to a frame&lt;/b&gt;&lt;br&gt;&lt;br&gt;from RGMII (copper) -- always forwarded to SGMII, and a copy&lt;br&gt;goes to the endpoint, which does one of:&lt;br&gt;&amp;nbsp;&amp;nbsp;answers it itself ..... NDP NS/NA, ICMPv6 echo&lt;br&gt;&amp;nbsp;&amp;nbsp;hands it to eth_mgmt ... UDP port 28536&lt;br&gt;&amp;nbsp;&amp;nbsp;drops it ............... everything else&lt;br&gt;&lt;br&gt;from SGMII (host) -- forwarded to RGMII, never examined.&lt;br&gt;responses are injected toward RGMII only: management&lt;br&gt;rides the copper side." style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Courier New;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;strokeWidth=1;fillColor=none;fontColor=#F5B944;strokeColor=#F5B944;arcSize=3;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="650" width="620" height="200" as="geometry" />
        </mxCell>


load("//tools:hdl.bzl", "vhdl_unit", "black_box", "vunit_sim")
load("//tools:vivado.bzl", "vivado_bitstream")

# Black-box stubs for the Vivado-generated cores (the GT wizard and the IDELAY
# reference MMCM). These analyze for the LSP but are dropped from synth, where
# Vivado binds them to the IP generated by the pre_synth tcl scripts.
black_box(
    name = "bridge_black_boxes",
    srcs = glob(["black_box_entities/*.vhd"]),
    visibility = ["PUBLIC"],
)

# 2:1 gearbox + comma re-alignment between the GTY 20-bit raw datapath and the
# soft PCS 10-bit code groups. Pure fabric logic; self-tested below.
vhdl_unit(
    name = "sgmii_gearbox",
    srcs = ["gt/sgmii_gearbox.vhd"],
    standard = "2019",
    visibility = ["PUBLIC"],
)

# GTY transceiver wrapper: presents the soft SGMII PCS with comma-aligned 10-bit
# code groups in a single 125 MHz user-clock domain.
vhdl_unit(
    name = "sgmii_gt",
    srcs = ["gt/sgmii_gt.vhd"],
    deps = [
        ":sgmii_gearbox",
        ":bridge_black_boxes",
    ],
    standard = "2019",
    visibility = ["PUBLIC"],
)

vunit_sim(
    name = "sgmii_gearbox_tb",
    srcs = glob(["gt/sims/*.vhd"]),
    deps = [
        ":sgmii_gearbox",
        "//hdl/ip/vhd/8b10b:helper_8b10b_pkg",
    ],
    standard = "2019",
    visibility = ["PUBLIC"],
)

# MDIO master + DP83867 RGMII-ID startup init.
vhdl_unit(
    name = "mdio",
    srcs = ["mdio/mdio_master.vhd", "mdio/dp83867_init.vhd"],
    standard = "2019",
    visibility = ["PUBLIC"],
)

vunit_sim(
    name = "mdio_master_tb",
    srcs = glob(["mdio/sims/*.vhd"]),
    deps = [":mdio"],
    standard = "2019",
    visibility = ["PUBLIC"],
)

vhdl_unit(
    name = "xem8320_sgmii_rgmii_top",
    srcs = ["xem8320_sgmii_rgmii_top.vhd"],
    deps = [
        ":sgmii_gt",
        ":mdio",
        ":bridge_black_boxes",
        "//hdl/ip/vhd/ethernet/gmii:gmii_pkg",
        "//hdl/ip/vhd/ethernet/sgmii:sgmii_pkg",
        "//hdl/ip/vhd/ethernet/rgmii:rgmii_pkg",
        "//hdl/ip/vhd/ethernet/sgmii_to_rgmii:sgmii_to_rgmii",
        "//hdl/ip/vhd/synchronizers:async_reset_bridge",
    ],
    standard = "2019",
)

vivado_bitstream(
    name = "xem8320_sgmii_rgmii",
    top_entity_name = "xem8320_sgmii_rgmii_top",
    top = ":xem8320_sgmii_rgmii_top",
    part = "xcau25p-ffvb676-2-e",
    constraints = glob(["*.xdc"]),
    pre_synth_tcl_files = glob(["xilinx_ip_gen/*.tcl"]),
    post_synth_tcl_files = ["post_synth_timing.tcl", "ila.tcl"],
)
